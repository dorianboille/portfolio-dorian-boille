---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { ProjectShowcase, type ProjectPreview } from '@/components/projects/ProjectShowcase';

const raw = await getCollection('projets');
const sorted = [...raw].sort((a, b) => a.data.order - b.data.order);

const projects: ProjectPreview[] = await Promise.all(
	sorted.map(async (entry) => {
		const cover = await getImage({
			src: entry.data.cover,
			width: 960,
		});
		const gallery = await Promise.all(
			entry.data.gallery.map((item) => getImage({ src: item.image, width: 1400 })),
		);

		const baseUrl = import.meta.env.BASE_URL;
		const detailUrl = baseUrl.endsWith('/')
			? `${baseUrl}projets/${entry.id}/`
			: `${baseUrl}/projets/${entry.id}/`;

		return {
			id: entry.id,
			title: entry.data.title,
			excerpt: entry.data.excerpt,
			date: entry.data.date.toISOString(),
			duration: entry.data.duration,
			type: entry.data.type,
			stack: entry.data.stack,
			cover: {
				src: cover.src,
				width: Number(cover.attributes.width ?? 960),
				height: Number(cover.attributes.height ?? 640),
				alt: entry.data.coverAlt,
			},
			gallery: gallery.map((g, i) => ({
				src: g.src,
				width: Number(g.attributes.width ?? 1200),
				height: Number(g.attributes.height ?? 800),
				alt: entry.data.gallery[i].alt,
			})),
			detailUrl,
		};
	}),
);

const description =
	'Ingénieur informatique chez Diwio. Depuis 2022, je développe la solution de comptage de vélos par caméra : modèle de vision, déploiement sur cartes NVIDIA et cloud AWS.';
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Dorian Boille',
	jobTitle: 'Ingénieur informatique',
	description,
	email: 'dorian.boille63800@gmail.com',
	worksFor: {
		'@type': 'Organization',
		name: 'Diwio',
	},
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Nantes',
		addressCountry: 'FR',
	},
	knowsAbout: ['Computer vision', 'Python', 'NVIDIA', 'AWS', 'ESP', 'PoE', 'Électronique'],
	sameAs: ['https://www.linkedin.com/in/dorian-boille/'],
	...(pageUrl ? { url: pageUrl } : {}),
};
---

<Layout title="Dorian Boille — Ingénieur informatique" description={description} jsonLd={jsonLd}>
	<main class="mx-auto max-w-6xl px-6 pb-24 pt-20 md:px-10 md:pt-28">
		<header class="mx-auto max-w-2xl text-center">
			<p class="text-sm font-medium tracking-wide text-zinc-400">Portfolio</p>
			<h1 class="mt-3 text-4xl font-semibold tracking-tight text-zinc-900 md:text-5xl">
				Dorian Boille
			</h1>
			<p class="mt-2 text-lg text-zinc-500 md:text-xl">Ingénieur informatique · Diwio · Nantes</p>
			<p class="mx-auto mt-8 max-w-xl text-balance text-base leading-relaxed text-zinc-600">
				Je suis Dorian, ingénieur informatique chez Diwio. Depuis 2022, je développe la solution de comptage de vélos par caméra : modèle de vision, déploiement sur cartes NVIDIA et cloud AWS. Je l’ai construite seul, puis faite évoluer avec un second ingénieur IA pour la V2. Je conçois aussi des cartes électroniques pour les parkings, comme l’armoire de commande et l’afficheur de places.
			</p>
			<nav class="mt-8 flex flex-col items-center gap-3 text-sm font-medium sm:flex-row sm:justify-center sm:gap-6" aria-label="Contact">
				<a
					href="mailto:dorian.boille63800@gmail.com"
					class="text-zinc-900 underline underline-offset-4 transition-colors hover:text-zinc-600"
				>
					dorian.boille63800@gmail.com
				</a>
				<a
					href="https://www.linkedin.com/in/dorian-boille/"
					class="text-zinc-900 underline underline-offset-4 transition-colors hover:text-zinc-600"
					rel="me noopener noreferrer"
					target="_blank"
				>
					LinkedIn
				</a>
			</nav>
		</header>

		<section class="mt-20 md:mt-28" aria-labelledby="projets-heading">
			<div class="mb-10 flex flex-col gap-2 text-center md:mb-14">
				<h2 id="projets-heading" class="text-sm font-medium uppercase tracking-[0.2em] text-zinc-400">
					Projets
				</h2>
				<p class="text-base text-zinc-600">Sélection récente — cliquez sur une carte pour plus de détails.</p>
			</div>

			<ProjectShowcase client:visible projects={projects} />
		</section>
	</main>
</Layout>
