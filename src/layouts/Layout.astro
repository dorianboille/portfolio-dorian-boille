---
import '@/styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Portfolio',
	description = 'Ingénieur informatique — projets professionnels et personnels.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-[#ffffff] text-foreground antialiased">
		<slot />
	</body>
</html>
